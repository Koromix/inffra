goupile1_ip = '192.168.58.3'
aeryn_ip = '192.168.58.4'
cloud1_ip = '192.168.58.8'
cloud2_ip = '192.168.58.10'
tools1_ip = '192.168.58.5'
tools2_ip = '192.168.58.7'
wordpress_ip = '192.168.58.6'
bouncer_ip = '192.168.58.9'

Vagrant.configure('2') do |config|
    config.hostmanager.enabled = true
    config.hostmanager.manage_host = true

    config.vm.define 'goupile1' do |m|
        m.vm.box = 'generic/debian11'
        m.vm.hostname = 'pknet-goupile1.local'
        m.vm.network 'private_network', ip: goupile1_ip

        # It's kind of ugly to hardcode this but.. meh. Keep it simple
        m.hostmanager.aliases = ['goupile1.pknet.local', 'goupile2.pknet.local']

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_goupile1'
            v.memory = 4096
            v.cpus = 4
            v.linked_clone = true
            v.gui = false
        end
    end

    config.vm.define 'aeryn' do |m|
        m.vm.box = 'generic/debian11'
        m.vm.hostname = 'pknet-aeryn.local'
        m.vm.network 'private_network', ip: aeryn_ip

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_aeryn'
            v.memory = 2048
            v.cpus = 1
            v.linked_clone = true
            v.gui = false
        end
    end

    config.vm.define 'cloud1' do |m|
        m.vm.box = 'generic/debian11'
        m.vm.hostname = 'pknet-cloud1.local'
        m.vm.network 'private_network', ip: cloud1_ip

        # It's kind of ugly to hardcode this but.. meh. Keep it simple
        m.hostmanager.aliases = ['cloud1.pknet.local']

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_cloud1'
            v.memory = 4096
            v.cpus = 2
            v.linked_clone = true
            v.gui = false
        end
    end

    config.vm.define 'cloud2' do |m|
        m.vm.box = 'generic/debian11'
        m.vm.hostname = 'pknet-cloud2.local'
        m.vm.network 'private_network', ip: cloud2_ip

        # It's kind of ugly to hardcode this but.. meh. Keep it simple
        m.hostmanager.aliases = ['cloud2.pknet.local']

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_cloud2'
            v.memory = 4096
            v.cpus = 2
            v.linked_clone = true
            v.gui = false
        end
    end

    config.vm.define 'tools1' do |m|
        m.vm.box = 'generic/debian11'
        m.vm.hostname = 'pknet-tools1.local'
        m.vm.network 'private_network', ip: tools1_ip

        # It's kind of ugly to hardcode this but.. meh. Keep it simple
        m.hostmanager.aliases = ['git.pknet.local', 'thop.pknet.local', 'chat.pknet.local']

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_tools'
            v.memory = 4096
            v.cpus = 2
            v.linked_clone = true
            v.gui = false
        end
    end

    config.vm.define 'tools2' do |m|
        m.vm.box = 'generic/debian11'
        m.vm.hostname = 'pknet-tools2.local'
        m.vm.network 'private_network', ip: tools2_ip

        # It's kind of ugly to hardcode this but.. meh. Keep it simple
        m.hostmanager.aliases = ['forum.pknet.local']

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_tools2'
            v.memory = 2048
            v.cpus = 1
            v.linked_clone = true
            v.gui = false
        end
    end

    config.vm.define 'wordpress' do |m|
        m.vm.box = 'generic/debian11'
        m.vm.hostname = 'pknet-wordpress.local'
        m.vm.network 'private_network', ip: wordpress_ip

        # It's kind of ugly to hardcode this but.. meh. Keep it simple
        m.hostmanager.aliases = ['cn2r.pknet.local']

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_wordpress'
            v.memory = 4096
            v.cpus = 2
            v.linked_clone = true
            v.gui = false
        end
    end

    config.vm.define 'bouncer' do |m|
        m.vm.box = 'generic/debian12'
        m.vm.hostname = 'pknet-bouncer.local'
        m.vm.network 'private_network', ip: bouncer_ip

        m.vm.provider 'virtualbox' do |v|
            v.name = 'pknet_bouncer'
            v.memory = 2048
            v.cpus = 1
            v.linked_clone = true
            v.gui = false
        end

        m.vm.provision 'ansible' do |ansible|
            ansible.playbook = '../../pknet.yml'
            ansible.limit = 'all'
            ansible.inventory_path = '../inventories/vagrant/hosts.yml'
            ansible.extra_vars = { ansible_python_interpreter: '/usr/bin/python3' }
            ansible.vault_password_file = '../../keys/pknet.vault'
            # ansible.raw_arguments = ['--check']
        end
    end
end
