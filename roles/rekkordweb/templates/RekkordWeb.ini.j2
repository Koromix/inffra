[General]
Title = {{ rekkordweb_title }}
URL = {{ rekkordweb_url }}

[Data]
DatabaseFile = data/data.db
TempDirectory = tmp

[HTTP]
SocketType = Unix
UnixPath = /run/rekkordweb/{{ rekkordweb_name }}.sock
ClientAddress = X-Forwarded-For

[SMTP]
URL = {{ rekkordweb_smtp.url }}
{% if rekkordweb_smtp.username is defined %}
Username = {{ rekkordweb_smtp.username }}
Password = {{ rekkordweb_smtp.password }}
{% endif %}
From = {{ rekkordweb_smtp.from }}

{% if rekkordweb_extra is defined %}
{% for section, values in rekkordweb_extra.items() %}
[{{ section }}]
{% for key, value in values.items() %}
{{ key }}={{ value }}
{% endfor %}

{% endfor %}
{% endif %}
