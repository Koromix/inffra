[General]
Title = {{ redropp_title }}
URL = {{ redropp_url }}

[Data]
DatabaseFile = data/data.db
TempDirectory = tmp

[HTTP]
SocketType = Unix
UnixPath = /run/redropp/{{ redropp_name }}.sock
ClientAddress = X-Forwarded-For

[Drop]
Quota = {{ redropp_quota }}

[S3]
Location = {{ redropp_s3.location }}
KeyID = {{ redropp_s3.access_key_id }}
SecretKey = {{ redropp_s3.secret_access_key }}

[SMTP]
URL = {{ redropp_smtp.url }}
{% if redropp_smtp.username is defined %}
Username = {{ redropp_smtp.username }}
Password = {{ redropp_smtp.password }}
{% endif %}
From = {{ redropp_smtp.from }}

{% if redropp_extra is defined %}
{% for section, values in redropp_extra.items() %}
[{{ section }}]
{% for key, value in values.items() %}
{{ key }}={{ value }}
{% endfor %}

{% endfor %}
{% endif %}
