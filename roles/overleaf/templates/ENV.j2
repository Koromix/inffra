OVERLEAF_MONGO_URL={{ overleaf_database }}
OVERLEAF_REDIS_HOST=172.17.0.1
REDIS_HOST=172.17.0.1

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true

OVERLEAF_APP_NAME={{ overleaf_title }}
OVERLEAF_SITE_URL={{ overleaf_url }}
OVERLEAF_NAV_TITLE={{ overleaf_title }}
OVERLEAF_ADMIN_EMAIL={{ overleaf_admin_mail }}

OVERLEAF_EMAIL_FROM_ADDRESS={{ overleaf_smtp.from }}
OVERLEAF_EMAIL_SMTP_HOST={{ overleaf_smtp.host | split(':') | first }}
OVERLEAF_EMAIL_SMTP_PORT={{ overleaf_smtp.host | split(':') | last }}
OVERLEAF_EMAIL_SMTP_SECURE={{ 'true' if overleaf_smtp.mode is defined and overleaf_smtp.mode == 'smtps' else 'false' }}
{% if overleaf_smtp.username is defined %}
OVERLEAF_EMAIL_SMTP_USER={{ overleaf_smtp.username }}
OVERLEAF_EMAIL_SMTP_PASS={{ overleaf_smtp.password }}
{% endif %}
OVERLEAF_EMAIL_SMTP_IGNORE_TLS={{ 'false' if overleaf_smtp.mode is defined and
                                             (overleaf_smtp.mode == 'starttls' or overleaf_smtp.mode == 'smtps') else 'true' }}
OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true

OVERLEAF_SECURE_COOKIE=true
OVERLEAF_BEHIND_PROXY=true
