[General]
Title = {{ rekkow_title }}
URL = {{ rekkow_url }}

[Data]
DatabaseFile = data/data.db
TempDirectory = tmp

[HTTP]
SocketType = Unix
UnixPath = /run/rekkow/{{ rekkow_name }}.sock
ClientAddress = X-Forwarded-For

[SMTP]
URL = {{ rekkow_smtp.url }}
{% if rekkow_smtp.username is defined %}
Username = {{ rekkow_smtp.username }}
Password = {{ rekkow_smtp.password }}
{% endif %}
From = {{ rekkow_smtp.from }}
