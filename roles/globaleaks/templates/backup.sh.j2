cd "{{ globaleaks_backup_path }}"

rsync -a --delete /var/globaleaks/ globaleaks/
rm -f globaleaks/globaleaks.db
sqlite3 /var/globaleaks/globaleaks.db ".backup 'globaleaks/globaleaks.db'"

tar cf backups/$(date +%Y%m%d_%H%M%S).tar globaleaks
ls -1 backups/* | sort -r | tail -n +4 | xargs rm -f
