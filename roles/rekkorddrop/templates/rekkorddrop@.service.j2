[Unit]
Description=Rekkord Drop %i
Documentation=https://rekkord.org/drop
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User={{ rekkorddrop_run_user }}
Group={{ rekkorddrop_run_group }}
RuntimeDirectory=rekkorddrop
RuntimeDirectoryPreserve=yes
WorkingDirectory={{ rekkorddrop_root_path }}/%i
ExecStart={{ rekkorddrop_root_path }}/RekkordDrop {{ '--sandbox' if rekkorddrop_sandbox else '' }}
Restart=on-failure
RestartSec=20
TimeoutStopSec=30

{% if rekkorddrop_sandbox %}
# Allow Rekkow to manipulate namespaces despite
# kernel.unprivileged_userns_clone=0.
SecureBits=keep-caps
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
{% endif %}

[Install]
WantedBy=multi-user.target
