cd "{{ postgresql_backup_path }}"

suffix=_$(date +%Y%m%d%H%M%S)

for db in $(sudo -u postgres psql -t -c "select datname from pg_database where not datistemplate" | grep '\S' | awk '{$1=$1};1'); do
   sudo -u postgres pg_dump "$db" > "backups/$db$suffix.sql"
done
sudo -u postgres pg_dumpall --globals-only > "backups/globals$suffix.sql"

find backups/ -name '*.sql' -daystart -mtime +3 -delete
